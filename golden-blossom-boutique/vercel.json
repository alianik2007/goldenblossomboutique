{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "*.json"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/admin.js", "destination": "/admin/admin.js" }
  ]
}
